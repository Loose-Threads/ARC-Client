{
  "name": "arc-osc-client",
  "version": "0.93.4",
  "author": "ComfyChloe",
  "description": "Standalone OSC Client for ARC-OSC",
  "main": "./out/main/index.js",
  "license": "ComfyChloe-NCCL-1.2",
  "private": false,
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "bonjour-service": "^1.3.0",
    "extract-zip": "^2.0.1",
    "osc": "2.4.5",
    "portfinder": "^1.0.38",
    "socket.io-client": "4.7.4",
    "vosk-koffi": "^1.1.1",
    "vrchat": "^2.20.5",
    "vrchat-log-watcher": "^0.5.1",
    "vue": "^3.5.30",
    "vue-router": "^4.6.4",
    "ws": "^8.18.3"
  },
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/prepare-bundled-libs.mjs",
    "build": "electron-vite build && electron-builder --dir",
    "pack": "electron-builder --dir",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.15",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "33.0.0",
    "electron-builder": "25.1.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "build": {
    "appId": "com.arcrosc.oscclient",
    "productName": "ARC-OSC Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "Assets/**/*",
      "secrets.json",
      "package.json",
      "!node_modules/**/*.md",
      "!node_modules/**/*.txt",
      "!node_modules/**/LICENSE*",
      "!node_modules/**/CHANGELOG*",
      "!node_modules/**/README*",
      "!node_modules/**/.npmignore",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/docs/**",
      "!node_modules/**/example/**",
      "!node_modules/**/examples/**",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@serialport/**/*",
      "**/node_modules/serialport/**/*",
      "**/node_modules/vosk-koffi/**/*",
      "**/node_modules/koffi/**/*"
    ],
    "extraResources": [
      { "from": "build/bundledLibs", "to": "../bundledLibs" },
      "userdata"
    ],
    "win": {
      "target": "dir",
      "icon": "Assets/ARC.ico"
    },
    "compression": "maximum"
  }
}
