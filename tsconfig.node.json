{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./out",
    "types": ["node"],
    "declaration": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/main/**/*", "src/preload/**/*", "electron.vite.config.ts"]
}
